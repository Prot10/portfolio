# FTP Deployment Credentials (for GitHub Actions secrets)
# These values should be added to GitHub repository secrets, not here
# Go to: Repository Settings > Secrets and variables > Actions > New repository secret

# FTP Server hostname (e.g., ftp.yourdomain.com)
FTP_SERVER=

# FTP Username (provided by Hostinger)
FTP_USERNAME=

# FTP Password (provided by Hostinger)
FTP_PASSWORD=

# Optional: Site URL for the GitHub environment
# Go to: Repository Settings > Environments > production > Add variable
# SITE_URL=https://yourdomain.com

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://7b883d075caa19b41fd9b00ae313a1c6@o4506813739368448.ingest.us.sentry.io/4507222371729408
